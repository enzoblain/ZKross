# Copy to apps/frontend/.env.local. VITE values are public browser configuration.
# Testnet never silently falls back to simulation. Live execution remains blocked.
VITE_PROTOCOL_MODE=simulation
VITE_SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
# Leave deployment fields empty until contract code, asset, verification keys,
# disclosure policy and CCTP adapter accounting have been verified together.
VITE_ETHEREUM_PRIVATE_POOL=
VITE_STELLAR_SPP_USDC_POOL=
VITE_CCTP_SEPOLIA_TOKEN_MESSENGER=0x8FE6B999Dc680CcFDD5Bf7EB0974218be2542DAA
VITE_CCTP_STELLAR_FORWARDER=CA66Q2WFBND6V4UEB7RD4SAXSVIWMD6RA4X3U32ELVFGXV5PJK4T4VSZ
VITE_PRIVACY_ADAPTER=
VITE_RELAYER_URL=
# Never place private keys, seeds, spending secrets or vault passwords here.
