{
  "comment": "One entry per constraint of bridge_out and bridge_in. Each mutation removes the constraint (deletes an `===`, or turns a constraining `<==` into an unconstrained `<--`) in a scratch copy; `<--` mutants that wire a value through also assign a wrong value, standing in for a malicious prover. The named test must FAIL on the mutant. Paths are relative to spp/circuits/src.",
  "mutations": [
    {"id": "O1", "stem": "bridge_out", "file": "zkross/bridge.circom", "find": "    component amountBits = Num2Bits(64);\n    amountBits.in <== amount;\n", "replace": "", "test": "bridge_out_rejects_an_amount_of_two_to_the_64", "what": "the bridged amount fits in 64 bits"},
    {"id": "O2", "stem": "bridge_out", "file": "zkross/bridge.circom", "find": "    (scale - 1) * (scale - 10) === 0;\n", "replace": "", "test": "bridge_out_rejects_a_scale_other_than_1_or_10", "what": "scale is 1 or 10"},
    {"id": "O3", "stem": "bridge_out", "file": "zkross/bridge.circom", "find": "    core.publicAmount <== 0 - bridged.value;", "replace": "    core.publicAmount <-- 0 - bridged.value + 1;", "test": "bridge_out_rejects_unbalanced_amounts", "what": "the value leaving the notes is exactly amount x scale (the balance's public amount)"},
    {"id": "O4", "stem": "bridge_out", "file": "zkross/bridge.circom", "find": "    msg.out === bridgeMessage;\n", "replace": "", "test": "bridge_out_rejects_a_wrong_bridge_message", "what": "the public C is the hash of its fields"},
    {"id": "O5", "stem": "bridge_out", "file": "zkross/bridge.circom", "find": "    msg.amount <== amount;", "occurrence": 1, "replace": "    msg.amount <-- amount + 1;", "test": "bridge_out_c_carries_exactly_the_bridged_amount", "what": "C carries the amount actually spent"},
    {"id": "O6", "stem": "bridge_out", "file": "zkross/bridge.circom", "find": "    msg.dstChain <== dstChain;", "occurrence": 1, "replace": "    msg.dstChain <-- 11155111;", "test": "bridge_out_rejects_a_wrong_chain_id", "what": "C carries the public chain IDs (here the destination)"},
    {"id": "O7", "stem": "bridge_out", "file": "zkross/bridge.circom", "find": "    refund.out === refundCommitment;\n", "replace": "", "test": "bridge_out_rejects_a_refund_note_worth_less", "what": "the public refund commitment is the refund note's"},
    {"id": "O8", "stem": "bridge_out", "file": "zkross/bridge.circom", "find": "    refund.inputs[0] <== bridged.value;", "replace": "    refund.inputs[0] <-- bridged.value - 1;", "test": "bridge_out_rejects_a_refund_note_worth_less", "what": "the refund note is worth exactly amount x scale"},
