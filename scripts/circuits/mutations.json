    {"id": "O20", "stem": "bridge_out", "file": "zkross/bridge.circom", "find": "    gvk.nonce <== nonce;", "occurrence": 1, "replace": "    gvk.nonce <-- nonce + 1;", "test": "bridge_out_computes_the_expected_public_signals", "what": "the encryption uses the public nonce"},
