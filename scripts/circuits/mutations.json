    {"id": "O25", "stem": "bridge_out", "file": "policyTransaction.circom", "find": "        outAmountCheck[tx] = Num2Bits(248);\n        outAmountCheck[tx].in <== outAmount[tx];\n", "replace": "", "test": "bridge_out_rejects_a_change_amount_over_the_range_limit", "what": "(SPP core) each change amount fits in 248 bits"},
    {"id": "O26", "stem": "bridge_out", "file": "policyTransaction.circom", "find": "            sameNullifiers[index].out === 0;\n", "replace": "", "test": "bridge_out_rejects_two_identical_input_nullifiers", "what": "(SPP core) the two input nullifiers differ"},
    {"id": "O27", "stem": "bridge_out", "file": "policyTransaction.circom", "find": "    sumIns + publicAmount === sumOuts;\n", "replace": "", "test": "bridge_out_rejects_unbalanced_amounts", "what": "(SPP core) inputs = change + amount x scale"},

