# Public browser configuration only: every VITE_* value ends up in the bundle.
# Never put private keys, seeds, note secrets or the Global View Key here.
# Copy to apps/frontend/.env.local to override the defaults.

# Pool, verifier and USDC addresses are read from the repo's deployments.json
# at build time; nothing to set for them.

# Sepolia JSON-RPC endpoint used for reads (writes go through MetaMask).
VITE_SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# Relayer (services/bridge, `npm run service`): sends bridge outs, claims and
# withdrawals from its own accounts. Public URL only; its keys stay in the
# service's .env.
VITE_RELAYER_URL=http://127.0.0.1:8788
